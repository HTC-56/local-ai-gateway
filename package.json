{
  "name": "local-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One OpenAI-compatible endpoint fronting N local model servers, with logical routing, health failover and egress attestation.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scrub": "bash scripts/scrub-check.sh",
    "verify": "bash verify.sh"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
